# EnvisaLink EVL module's own IP and TPI port (not the alarm panel's own
# address -- there isn't one; the panel only speaks to the EnvisaLink
# over its internal keybus).
ENVISALINK_HOST=10.0.0.30
ENVISALINK_PORT=4025

# The EnvisaLink's own TPI password -- it's the SAME password used to
# log into the EnvisaLink's local web UI (there's no separate "TPI
# password" field, and no username at all in this protocol). NOT the
# alarm panel's own keypad access code -- this app only listens for
# status broadcasts, it never arms, disarms, or bypasses anything, so
# no panel access code is needed at all.
ENVISALINK_PASSWORD=

# This protocol doesn't expose zone names/types at all, only zone
# numbers -- see zone_map.json.example (copy to zone_map.json and fill
# in your real zone numbers/names/types). Same idea for partitions via
# partition_map.json.example, though most residential installs have
# just one partition and the default ({"1": "Main"}) is fine as-is.
ZONE_MAP_FILE=zone_map.json
PARTITION_MAP_FILE=partition_map.json

API_BASE_URL=http://10.0.0.13/v1
